{
  "manifest_version": 3,
  "name": "Three Focus Blocker",
  "version": "0.3.0",
  "description": "Blocks the sites you chose in Three while you focus. Checks addresses on your Mac and tells Three only which rule matched.",
  "key": "",
  "minimum_chrome_version": "120",
  "incognito": "not_allowed",
  "permissions": ["declarativeNetRequestWithHostAccess", "nativeMessaging", "alarms", "storage"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js", "type": "module" },
  "web_accessible_resources": [{ "resources": ["block.html"], "matches": ["<all_urls>"] }]
}
